# ============================================================
# DISASTER RESPONSE INTELLIGENCE — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ============================================================

# ── X (Twitter) API v2 ──────────────────────────────────────
# Required for live social media ingestion.
# Apply at: https://developer.twitter.com/en/portal/dashboard
X_BEARER_TOKEN=

# ── Reddit API ──────────────────────────────────────────────
# Required for Reddit disaster subreddit monitoring.
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DisasterIntelligence/1.0

# ── HuggingFace Hub ─────────────────────────────────────────
# For model upload/download from HF Hub (optional).
HF_TOKEN=

# ── App Configuration ────────────────────────────────────────
# Override default OSRM server (leave blank to use public)
OSRM_BASE_URL=http://router.project-osrm.org

# Override default Open-Meteo URL (leave blank to use public)
OPENMETEO_BASE_URL=https://api.open-meteo.com

# Location for risk model (lat, lon for Bhubaneswar by default)
DEFAULT_LATITUDE=20.2961
DEFAULT_LONGITUDE=85.8245

# SQLite DB path (leave blank to use in-memory / session state only)
DB_PATH=data/incidents.db

# Auto-refresh intervals (seconds)
WEATHER_REFRESH_INTERVAL=900
GDACS_REFRESH_INTERVAL=300
SOCIAL_REFRESH_INTERVAL=60
